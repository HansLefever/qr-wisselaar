rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Alleen dit ene document is publiek toegankelijk.
    match /qrGame/main {

      // Nodig omdat de browser de huidige teller eerst leest.
      allow read: if true;

      // Alleen bestaande teller + exact 1 toestaan.
      // Geen extra velden toevoegen/verwijderen.
      allow update: if
        request.resource.data.keys().hasOnly(['count']) &&
        resource.data.keys().hasOnly(['count']) &&
        resource.data.count is int &&
        request.resource.data.count is int &&
        request.resource.data.count == resource.data.count + 1;

      // Het document maken/verwijderen vanuit de publieke website is verboden.
      allow create, delete: if false;
    }

    // Al het overige blokkeren.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
